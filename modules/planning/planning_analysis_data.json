  "two_phase_planning": {
    "description": "路径-速度分离规划(核心算法架构)",
    "path_phase": {
      "description": "路径规划阶段 - 在Frenet坐标系下优化横向位移",
      "steps": [
        "1. 生成候选PathBoundary(车道跟随/借道/换道/靠边)",
        "2. 在PathBoundary内优化路径(Frenet l坐标)",
        "3. 选择最优路径(基于代价函数)",
        "4. PathDecider对障碍物做决策(忽略/绕行/停止)"
      ]
    },
    "speed_phase": {
      "description": "速度规划阶段 - 在ST图上优化纵向速度",
      "steps": [
        "1. SpeedBoundsDecider计算ST图边界",
        "2. PathTimeHeuristicOptimizer用DP求粗略速度曲线",
        "3. SpeedDecider决定跟车/超车/停车",
        "4. SpeedBoundsDecider用决策结果重新计算边界",
        "5. PiecewiseJerkSpeedOptimizer用QP精细优化速度曲线"
      ]
    },
    "merge_phase": {
      "description": "合并阶段",
      "steps": [
        "1. CombinePathAndSpeedProfile将路径和速度合并为轨迹",
        "2. 每个路径点(s,l) + 速度点(s,t) -> 轨迹点(x,y,v,a,t)"
      ]
    }
  }
}
