  "planning_cycle_flow": {
    "description": "一次完整规划周期流程",
    "steps": [
      {
        "step": 1,
        "name": "PlanningComponent::Proc()",
        "description": "接收3个主输入，组装LocalView，检查数据就绪",
        "sub_steps": [
          "CheckRerouting()",
          "组装LocalView(prediction/chassis/localization/traffic_light/pad_msg/planning_command/stories/control_interactive)",
          "CheckInput()(检查localization/chassis/map/planning_command就绪)",
          "学习模式数据处理(如果启用)",
          "调用PlanningBase::RunOnce()"
        ]
      },
      {
        "step": 2,
        "name": "OnLanePlanning::RunOnce()",
        "description": "车道线模式规划主循环",
        "sub_steps": [
          "更新ReferenceLineProvider(从路由获取参考线)",
          "TrajectoryStitcher::Stitch()(缝合历史轨迹与新规划起始点)",
          "InitFrame()(初始化规划帧)",
          "  - 获取参考线列表",
          "  - 裁剪参考线(FLAGS_look_backward_distance + LookForwardDistance)",
          "  - Frame::Init()(初始化障碍物/红绿灯/PadMsg等)",
          "  - TrafficDecider::Execute()(按顺序执行10种交通规则)",
          "Planner::Plan()(执行规划)"
        ]
      },
      {
        "step": 3,
        "name": "PublicRoadPlanner::Plan()",
        "description": "公开道路规划器",
        "sub_steps": [
          "ScenarioManager::Update()(场景切换判断)",
          "  - 遍历scenario_list_",
          "  - 当前场景STATUS_PROCESSING则不切换",
          "  - 检查各场景IsTransferable()",
          "  - 可切换: Exit(当前)->Reset(新)->Enter(新)",
          "Scenario::Process()(场景处理)"
        ]
      },
      {
        "step": 4,
        "name": "Scenario::Process()",
        "description": "场景处理，委托给当前Stage",
        "sub_steps": [
          "current_stage_->Process(planning_init_point, frame)",
          "Stage内部按序执行Task列表"
        ]
      },
      {
        "step": 5,
        "name": "Stage::ExecuteTaskOnReferenceLine()",
        "description": "在参考线上执行任务链(典型的OnLane流程)",
        "sub_steps": [
          "路径规划阶段:",
          "  1. LaneChangePath/LaneFollowPath/LaneBorrowPath(候选路径生成)",
          "  2. FallbackPath(后备路径)",
          "  3. PathDecider(路径决策-忽略/绕行/停止)",
          "  4. RuleBasedStopDecider(基于规则停车决策)",
          "速度规划阶段:",
          "  5. SpeedBoundsDecider(priori)(先验速度边界)",
          "  6. PathTimeHeuristicOptimizer(DP速度优化)",
          "  7. SpeedDecider(速度决策-跟车/超车/停车)",
          "  8. SpeedBoundsDecider(final)(最终速度边界)",
          "  9. PiecewiseJerkSpeedOptimizer(QP速度优化)",
          "合并阶段:",
          "  10. CombinePathAndSpeedProfile(合并路径和速度为轨迹)"
        ]
      },
      {
        "step": 6,
        "name": "输出处理",
        "description": "填充并发布规划结果",
        "sub_steps": [
          "CombinePathAndSpeedProfile(合并路径和速度曲线)",
          "FillPlanningPb(填充轨迹消息头部/时间戳)",
          "SetLocation(设置位置和车道边界)",
          "修正轨迹点relative_time",
          "PlanningComponent::planning_writer_->Write(发布ADCTrajectory)",
          "发布CommandStatus(RUNNING/FINISHED/ERROR)",
          "记录到History"
        ]
      }
    ]
  },

