{
  "module": "planning",
  "version": "Apollo 11",
  "architecture_pattern": "Planner->Scenario->Stage->Task",
  "overview": {
    "description": "Apollo自动驾驶规划模块，负责根据感知、定位、路由等输入计算安全高效的行驶轨迹",
    "planning_frequency_hz": 10,
    "default_planner": "PublicRoadPlanner",
    "default_scenario": "LANE_FOLLOW"
  },

  "sub_modules": [
    {
      "name": "planning_component",
      "path": "modules/planning/planning_component",
      "description": "CyberRT组件层，规划模块的入口点",
      "core_classes": [
        {
          "name": "PlanningComponent",
          "file": "planning_component.h",
          "base_class": "cyber::Component<PredictionObstacles, Chassis, LocalizationEstimate>",
          "description": "CyberRT组件入口，订阅3个主话题+6个辅助话题，发布轨迹",
          "key_methods": ["Init()", "Proc()"],
          "subscribers": [
            {"topic_type": "PredictionObstacles", "source": "Prediction模块", "role": "主输入-障碍物预测"},
            {"topic_type": "Chassis", "source": "CAN总线", "role": "主输入-底盘状态"},
            {"topic_type": "LocalizationEstimate", "source": "Localization模块", "role": "主输入-定位"},
            {"topic_type": "TrafficLightDetection", "source": "Perception模块", "role": "红绿灯检测"},
            {"topic_type": "PadMessage", "source": "人机交互", "role": "驾驶员指令"},
            {"topic_type": "PlanningCommand", "source": "外部系统", "role": "规划命令"},
            {"topic_type": "Stories", "source": "Storytelling模块", "role": "场景故事"},
            {"topic_type": "ControlInteractiveMsg", "source": "Control模块", "role": "控制交互"},
            {"topic_type": "MapMsg", "source": "相对地图", "role": "仅导航模式"}
          ],
          "publishers": [
            {"topic_type": "ADCTrajectory", "target": "Control模块", "role": "主输出-规划轨迹"},
            {"topic_type": "CommandStatus", "target": "外部系统", "role": "命令状态反馈"},
            {"topic_type": "PlanningLearningData", "target": "学习系统", "role": "学习数据"},
            {"topic_type": "RoutingRequest", "target": "Routing模块", "role": "重路由请求"}
          ]
        },
        {
          "name": "PlanningBase",
          "file": "planning_base.h",
          "description": "规划基类，定义RunOnce/Plan接口",
          "key_methods": ["Init()", "RunOnce()", "Plan()", "IsPlanningFinished()"],
          "members": ["planner_", "frame_", "traffic_decider_", "injector_", "last_publishable_trajectory_"]
        },
        {
          "name": "OnLanePlanning",
          "file": "on_lane_planning.h",
          "base_class": "PlanningBase",
          "description": "基于车道线的规划模式(主要模式)，依赖HDMap",
          "key_methods": ["RunOnce()", "Plan()", "InitFrame()"],
          "members": ["reference_line_provider_", "planning_smoother_"]
        },
        {
          "name": "NaviPlanning",
          "file": "navi_planning.h",
          "base_class": "PlanningBase",
          "description": "导航模式规划，不依赖HDMap",
          "key_methods": ["RunOnce()", "Plan()", "ProcessPadMsg()"],
          "members": ["reference_line_provider_", "target_lane_id_"]
        }
      ]
    },
    {
      "name": "planning_base",
      "path": "modules/planning/planning_base",
      "description": "规划基础设施层，提供核心数据结构和算法",
      "sub_directories": [
        {
          "name": "common",
          "description": "核心数据结构(61个文件)",
          "core_classes": [
            {"name": "Frame", "file": "common/frame.h", "description": "规划帧，一帧规划的所有数据(参考线/障碍物/车辆状态)"},
            {"name": "ReferenceLineInfo", "file": "common/reference_line_info.h", "description": "参考线信息，一条参考线的所有规划数据(路径/速度/决策/代价)"},
            {"name": "Obstacle", "file": "common/obstacle.h", "description": "障碍物，包含感知和预测信息"},
            {"name": "PathDecision", "file": "common/path_decision.h", "description": "路径决策，对障碍物的nudge/overtake/stop决策"},
            {"name": "EgoInfo", "file": "common/ego_info.h", "description": "自车信息(位置/速度/边界框)"},
            {"name": "LocalView", "file": "common/local_view.h", "description": "输入数据结构(9个shared_ptr)"},
            {"name": "DependencyInjector", "file": "common/dependency_injector.h", "description": "依赖注入器(PlanningContext/FrameHistory/History/EgoInfo/VehicleState/LearningData)"},
            {"name": "PlanningContext", "file": "common/planning_context.h", "description": "跨帧规划状态(重路由/借道/换道等)"},
            {"name": "TrajectoryStitcher", "file": "common/trajectory_stitcher.h", "description": "轨迹缝合器，连接历史轨迹与新规划"},
            {"name": "SpeedLimit", "file": "common/speed_limit.h", "description": "速度限制曲线"},
            {"name": "StGraphData", "file": "common/st_graph_data.h", "description": "ST图数据"},
            {"name": "DecisionData", "file": "common/decision_data.h", "description": "决策数据"},
            {"name": "SLPolygon", "file": "common/sl_polygon.h", "description": "SL多边形，障碍物在SL坐标系的表示"}
          ]
        },
        {
          "name": "common/path",
          "description": "路径数据结构",
          "classes": ["DiscretizedPath", "FrenetFramePath", "PathData", "PathBoundary"]
        },
        {
          "name": "common/speed",
          "description": "速度数据结构",
          "classes": ["SpeedData", "STBoundary", "STPoint"]
        },
        {
          "name": "common/trajectory",
          "description": "轨迹数据结构",
          "classes": ["DiscretizedTrajectory", "PublishableTrajectory"]
        },
        {
          "name": "common/trajectory1d",
          "description": "一维轨迹",
          "classes": ["ConstantDecelerationTrajectory1d", "ConstantJerkTrajectory1d", "PiecewiseAccelerationTrajectory1d", "PiecewiseJerkTrajectory1d", "PiecewiseTrajectory1d", "StandingStillTrajectory1d"]
        },
        {
          "name": "reference_line",
          "description": "参考线生成与平滑(20个文件)",
          "core_classes": [
            {"name": "ReferenceLineProvider", "file": "reference_line/reference_line_provider.h", "description": "参考线提供者(从路由获取参考线)"},
            {"name": "ReferenceLine", "file": "reference_line/reference_line.h", "description": "参考线类(车道中心线+平滑)"},
            {"name": "DiscretePointsReferenceLineSmoother", "description": "离散点参考线平滑器"},
            {"name": "QpSplineReferenceLineSmoother", "description": "QP样条参考线平滑器"},
            {"name": "SpiralReferenceLineSmoother", "description": "螺旋线参考线平滑器"}
          ]
        },
        {
          "name": "proto",
          "description": "Protobuf定义(14个)",
          "files": ["planning_config.proto", "planning_status.proto", "learning_data.proto", "reference_line_smoother_config.proto", "piecewise_jerk_path_config.proto", "lattice_structure.proto", "planning_semantic_map_config.proto", "auto_tuning_model_input.proto", "auto_tuning_raw_feature.proto", "st_drivable_boundary.proto", "ipopt_return_status.proto", "plugin_declare_info.proto"]
        },
        {
          "name": "math",
          "description": "数学工具",
          "sub_dirs": ["constraint_checker", "curve1d", "discretized_points_smoothing", "piecewise_jerk", "smoothing_spline"],
          "core_classes": ["CurveMath", "DiscretePointsMath", "PolynomialXd"]
        },
        {
          "name": "gflags",
          "description": "规划配置标志",
          "files": ["planning_gflags.h(10.2KB)", "planning_gflags.cc(25.1KB)"]
        },
        {
          "name": "learning_based",
          "description": "学习模式数据",
          "files": ["birdview_img_feature_renderer相关"]
        }
      ]
    },
    {
      "name": "planners",
      "path": "modules/planning/planners",
      "description": "规划器层",
      "planners": [
        {
          "name": "PublicRoadPlanner",
          "path": "planners/public_road",
          "type": "PlannerWithReferenceLine",
          "is_default": true,
          "description": "公开道路规划器(主力)，基于Scenario架构",
          "core_classes": [
            {"name": "PublicRoadPlanner", "key_methods": ["Init()", "Plan()"]},
            {"name": "ScenarioManager", "key_methods": ["Init()", "Update()", "Reset()"]}
          ]
        },
        {
          "name": "LatticePlanner",
          "path": "planners/lattice",
          "type": "PlannerWithReferenceLine",
          "is_default": false,
          "description": "格子规划器，基于采样+评估的方法",
          "sub_dirs": ["behavior", "trajectory_generation"]
        },
        {
          "name": "NaviPlanner",
          "path": "planners/navi",
          "type": "PlannerWithReferenceLine",
          "is_default": false,
          "description": "导航规划器"
        },
        {
          "name": "RTKPlanner",
          "path": "planners/rtk",
          "type": "Planner",
          "is_default": false,
          "description": "录制回放规划器"
        }
      ]
    },
